# ==============================================================================
# LLM Evaluation & Red-Teaming Harness — Environment Configuration
# ==============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=9100
ENVIRONMENT=development

# ─── LLM Provider API Keys ───────────────────────────────────────────────────
# OpenAI (GPT-4o, GPT-4.1, o3, o4-mini)
OPENAI_API_KEY=

# Anthropic (Claude Opus, Sonnet, Haiku)
ANTHROPIC_API_KEY=

# Google Gemini (gemini-2.5-pro, gemini-2.5-flash)
GEMINI_API_KEY=

# HuggingFace Inference API
HUGGINGFACE_API_KEY=

# Ollama (local models — no key needed, just base URL)
OLLAMA_BASE_URL=http://localhost:11434

# ─── OpenAI-Compatible Endpoints ─────────────────────────────────────────────
# For vLLM, LM Studio, Together AI, Groq, etc.
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPATIBLE_API_KEY=

# ─── Application Settings ────────────────────────────────────────────────────
# Concurrency for batch evaluations
EVAL_CONCURRENCY=5
REDTEAM_CONCURRENCY=3

# Report output directory
REPORTS_DIR=reports
